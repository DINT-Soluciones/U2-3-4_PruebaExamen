<Window x:Class="U2_3_4_PruebaExamen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:U2_3_4_PruebaExamen"
        d:DataContext="{d:DesignInstance Type=local:Frase}"
        mc:Ignorable="d"
        Title="U2-3-4 Prueba examen - Solución" 
 		Height="550" Width="750" MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen">

         
        <Window.Resources>
        
        <Style TargetType="{x:Type Button}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="FontSize" Value="16"/>
         </Style>
        
        <Style TargetType="{x:Type Button}" x:Key="leftButtons" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect/>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Click" Handler="aceptarButton_Click"/>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="añadirButtonEstilo" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Content" Value="Añadir"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="ToolTip" Value="Botón para añadir notas."/>
            <EventSetter Event="Click" Handler="añadirButton_Click"/>

            <Setter Property="IsEnabled" Value="True"/>
            <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=textoTextBox, Path=Text}" Value="">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="{x:Type Border}" x:Key="bordes">
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        
        <Style TargetType="{x:Type TextBlock}" x:Key="titulo">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF939393"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Red" Offset="0"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="{x:Type Image}">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Stretch" Value="UniformToFill"/>
        </Style>
        
        <Style TargetType="{x:Type TextBox}" x:Key="Formulario">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="2"/>
         </Style>
    
    </Window.Resources>
    
    <!-- Cuerpo de la aplicación -->
    <Grid>
        <!-- Definición de la rejilla -->
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
       
        <Border Grid.Row="0" Grid.Column="0" Background="AliceBlue"  Style="{StaticResource bordes}">
            <DockPanel LastChildFill="False">
                <Button x:Name="aceptarButton" Content="Aceptar" Tag="Aceptar" DockPanel.Dock="Top" Style="{StaticResource leftButtons}" IsDefault="True"></Button>
                <Button x:Name="cancelarButton" Content="Cancelar" Tag="Cancelar" DockPanel.Dock="Bottom" Style="{StaticResource leftButtons}" IsCancel="True"></Button>
            </DockPanel>
        </Border>
        
        <DockPanel  Grid.Row="0" Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Text="Examen" Style="{StaticResource titulo}"/>

            <Border DockPanel.Dock="Bottom" Height="150"  Style="{StaticResource bordes}" Background="LightBlue" Padding="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"></ColumnDefinition>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Image Source="Assets/info.png" Grid.Row="0" Grid.Column="0" Stretch="Uniform" ToolTip="Escriba texto para añadir."/>

                    <TextBox x:Name="textoTextBox"
                             Style="{StaticResource Formulario}"
                             Text="{Binding TextoAlmacenado}"
                             />
                    
                    <Button x:Name="añadirButton"
                            Style="{StaticResource añadirButtonEstilo}"
                            />
                    
                    <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                        <WrapPanel x:Name="contenedorWrapPanel" Margin="5" Background="White">
                        </WrapPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Dejo para el final la parte de las imágenes para que ocupen el espacio restante del DOCKPANEL. -->
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <Image Source="Assets/solarsystem.jpg" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>
                
                <Image Source="Assets/digital.jpg" Grid.Row="1" Grid.Column="0"/>
                
                <Image Source="Assets/student.jpg" Grid.Row="1" Grid.Column="1"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
